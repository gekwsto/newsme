/// Tracks per-destination delivery of an Article to an external WordPress
/// (or future) publishing site, so the integration pipeline never resends
/// an article the destination already has. One row per (site, article).
model WordpressDelivery {
  id              String                  @id @default(cuid())
  site            String
  articleId       String
  article         Article                 @relation(fields: [articleId], references: [id], onDelete: Cascade)
  status          WordpressDeliveryStatus @default(SENT)
  wordpressPostId Int?
  wordpressUrl    String?
  ackAt           DateTime?
  ackError        String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@unique([site, articleId])
  @@index([site, status, createdAt])
  @@map("wordpress_deliveries")
}

enum WordpressDeliveryStatus {
  SENT
  PUBLISHED
  FAILED
}

/// Database-backed mutex so runNewsPipeline() cannot execute concurrently
/// from two different callers (Vercel cron + a WordPress-triggered request,
/// or two overlapping WordPress requests) across separate serverless
/// invocations, where an in-memory lock would not be shared. Single
/// singleton row (id: "news-auto-pipeline"), claimed via an atomic
/// conditional update and self-healing via lockedAt TTL if a process
/// crashes without releasing it.
model PipelineLock {
  id       String    @id
  lockedAt DateTime?

  @@map("pipeline_locks")
}

/// Backs the async "start + poll" WordPress integration flow
/// (POST /pipeline/start, GET /pipeline/[jobId]). Exists because the
/// production domain sits behind Cloudflare's proxy, whose default read
/// timeout (~100s) is well under the pipeline's worst-case duration — a
/// single long-held synchronous HTTP request cannot be relied on to survive.
/// This table lets a fast "start" request hand back a pollable id
/// immediately while the real (unmodified) runWordPressPipeline() keeps
/// running server-side via Next's after().
model WordPressPipelineJob {
  id            String    @id @default(cuid())
  site          String
  status        String    @default("processing") // processing | completed | failed
  pipelineRunId String?
  resultJson    Json?
  error         String?
  createdAt     DateTime  @default(now())
  finishedAt    DateTime?

  @@index([site, createdAt])
  @@map("wordpress_pipeline_jobs")
}
